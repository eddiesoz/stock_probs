{
  "version": 1,
  "rules": [
    {
      "name": "documentation-gate",
      "match": [
        "documentation-map.json",
        "scripts/check-doc-coverage.py",
        "scripts/check-doc-coverage-self-test.py",
        "scripts/setup-git-hooks.sh",
        ".githooks/**"
      ],
      "docs": [
        "docs/develop/documentation.md"
      ]
    },
    {
      "name": "local-gate",
      "match": [
        "scripts/local-gate.sh"
      ],
      "docs": [
        "docs/develop/testing.md"
      ]
    },
    {
      "name": "opencode-workflow",
      "match": [
        "opencode.json",
        ".opencode/.gitignore",
        ".opencode/agents/*.md",
        ".opencode/skills/**",
        ".opencode/skill-history/**",
        ".opencode/plugins/**",
        ".opencode/package.json",
        ".opencode/package-lock.json"
      ],
      "docs": [
        "docs/develop/documentation.md"
      ]
    },
    {
      "name": "model-routing",
      "match": [
        "model-routing.json",
        "scripts/sync_model_routing.py"
      ],
      "docs": [
        "docs/develop/documentation.md"
      ]
    },
    {
      "name": "codex-workflow",
      "match": [
        ".codex/**",
        ".agents/skills/**"
      ],
      "docs": [
        "docs/develop/documentation.md"
      ]
    },
    {
      "name": "deployment-review-pins",
      "match": [
        "scripts/pin_pr_rehearsal_review.py",
        "tools/deploy_mcp/pr_rehearsal.py"
      ],
      "docs": [
        "docs/develop/documentation.md",
        "docs/develop/testing.md",
        "docs/configure/local-configuration.md",
        "docs/operations/getting-started.md"
      ]
    },
    {
      "name": "project-commands",
      "match": [
        ".opencode/commands/*.md"
      ],
      "docs": [
        "docs/develop/documentation.md"
      ]
    },
    {
      "name": "bounded-docker-build-workflow",
      "match": [
        "compose.yaml",
        "scripts/arm64-smoke.sh",
        "scripts/bounded_docker_build.py",
        "scripts/local-compose.sh",
        "scripts/publish-production-image.sh",
        "scripts/rehearse_schema13.py",
        "scripts/r120-buildkitd.toml",
        "scripts/setup_bounded_buildkit.py",
        "tests/test_bounded_build_entrypoints.py",
        "tests/test_bounded_docker_build.py",
        "tests/test_production_deploy_helper.py",
        "tests/test_schema13_rehearsal.py",
        "tests/test_setup_builder_inventory.py",
        "tests/test_setup_builder_space_guard.py"
      ],
      "docs": [
        "docs/develop/documentation.md",
        "docs/develop/testing.md",
        "docs/operations/getting-started.md"
      ]
    },
    {
      "name": "research-workspaces",
      "match": [
        "src/stock_probs/research.py",
        "src/stock_probs/research_api.py",
        "src/stock_probs/migrations/014_research_workspaces.sql",
        "frontend/components/research/**",
        "frontend/app/research/theses/**",
        "frontend/app/tools/compare/**",
        "tests/test_research_workspaces.py",
        "tools/browser/tests/research-workspaces.spec.js"
      ],
      "docs": [
        "docs/usage/dashboard.md",
        "docs/reference/api.md",
        "docs/develop/design-system.md",
        "docs/security/threat-model.md"
      ]
    },
    {
      "name": "portfolio-ledger-workspaces",
      "match": [
        "src/stock_probs/portfolio_*.py",
        "src/stock_probs/migrations/015_portfolio_ledger.sql",
        "frontend/components/portfolio/**",
        "frontend/app/overview/transactions/**",
        "frontend/app/tools/what-if/**",
        "tests/test_portfolio_*.py",
        "tools/browser/tests/portfolio-workspaces.spec.js",
        "tools/browser/tests/tools-navigation.spec.js"
      ],
      "docs": [
        "docs/usage/dashboard.md",
        "docs/reference/api.md",
        "docs/develop/design-system.md",
        "docs/security/threat-model.md"
      ]
    },
    {
      "name": "monitoring-workspaces",
      "match": [
        "src/stock_probs/monitoring_*.py",
        "src/stock_probs/notification_*.py",
        "src/stock_probs/outcome_collection*.py",
        "src/stock_probs/report_*.py",
        "src/stock_probs/history_export.py",
        "src/stock_probs/migrations/016_monitoring_and_report_cards.sql",
        "src/stock_probs/migrations/017_outcome_owner_replace_guard.sql",
        "src/stock_probs/api.py",
        "src/stock_probs/backup.py",
        "src/stock_probs/config.py",
        "src/stock_probs/provider.py",
        "src/stock_probs/repository.py",
        "src/stock_probs/service.py",
        "frontend/components/monitoring/**",
        "frontend/app/notifications/**",
        "frontend/app/research/report-card/**",
        "frontend/components/workspace-nav.tsx",
        "frontend/tests/monitoring-client.test.mjs",
        "scripts/build_frontend.py",
        "tests/test_monitoring_*.py",
        "tests/test_notification_*.py",
        "tests/test_outcome_*.py",
        "tests/test_report_*.py",
        "tests/test_daily_outcome_provider.py",
        "tests/test_history_export.py",
        "tests/test_api.py",
        "tests/test_auth_repository.py",
        "tests/test_repository_backup.py",
        "tools/browser/monitoring_qa_server.py",
        "tools/browser/tests/monitoring-workspaces.spec.js",
        "tools/browser/tests/fixtures.js",
        "src/stock_probs/migrations/018_notification_address_delivery.sql"
      ],
      "docs": [
        "docs/usage/dashboard.md",
        "docs/reference/api.md",
        "docs/develop/design-system.md",
        "docs/develop/testing.md",
        "docs/security/threat-model.md"
      ]
    }
  ],
  "additional": [
    {
      "name": "workflow-policy",
      "match": [
        "documentation-map.json",
        "scripts/check-doc-coverage.py",
        "scripts/check-doc-coverage-self-test.py",
        "scripts/setup-git-hooks.sh",
        "model-routing.json",
        "scripts/sync_model_routing.py",
        "scripts/pin_pr_rehearsal_review.py",
        "tools/deploy_mcp/pr_rehearsal.py",
        ".githooks/**",
        "scripts/local-gate.sh",
        "opencode.json",
        ".opencode/.gitignore",
        ".opencode/agents/*.md",
        ".opencode/skills/**",
        ".opencode/skill-history/**",
        ".opencode/plugins/**",
        ".opencode/package.json",
        ".opencode/package-lock.json",
        ".opencode/commands/*.md",
        ".codex/**",
        ".agents/skills/**",
        "compose.yaml",
        "scripts/arm64-smoke.sh",
        "scripts/bounded_docker_build.py",
        "scripts/local-compose.sh",
        "scripts/publish-production-image.sh",
        "scripts/rehearse_schema13.py",
        "scripts/r120-buildkitd.toml",
        "scripts/setup_bounded_buildkit.py",
        "tests/test_bounded_build_entrypoints.py",
        "tests/test_bounded_docker_build.py",
        "tests/test_production_deploy_helper.py",
        "tests/test_schema13_rehearsal.py",
        "tests/test_setup_builder_inventory.py",
        "tests/test_setup_builder_space_guard.py"
      ],
      "docs": [
        "AGENTS.md"
      ]
    }
  ]
}
