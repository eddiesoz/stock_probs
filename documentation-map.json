{
  "version": 1,
  "rules": [
    {
      "name": "documentation-gate",
      "match": [
        "documentation-map.json",
        "scripts/check-doc-coverage.py",
        "scripts/check-doc-coverage-self-test.py",
        "scripts/setup-git-hooks.sh",
        ".githooks/**"
      ],
      "docs": [
        "docs/develop/documentation.md"
      ]
    },
    {
      "name": "local-gate",
      "match": [
        "scripts/local-gate.sh"
      ],
      "docs": [
        "docs/develop/testing.md"
      ]
    },
    {
      "name": "opencode-workflow",
      "match": [
        "opencode.json",
        ".opencode/.gitignore",
        ".opencode/agents/*.md",
        ".opencode/skills/**",
        ".opencode/skill-history/**",
        ".opencode/plugins/**",
        ".opencode/package.json",
        ".opencode/package-lock.json"
      ],
      "docs": [
        "docs/develop/documentation.md"
      ]
    },
    {
      "name": "model-routing",
      "match": [
        "model-routing.json",
        "scripts/sync_model_routing.py"
      ],
      "docs": [
        "docs/develop/documentation.md"
      ]
    },
    {
      "name": "codex-workflow",
      "match": [
        ".codex/**",
        ".agents/skills/**"
      ],
      "docs": [
        "docs/develop/documentation.md"
      ]
    },
    {
      "name": "deployment-review-pins",
      "match": [
        "scripts/pin_pr_rehearsal_review.py",
        "tools/deploy_mcp/pr_rehearsal.py"
      ],
      "docs": [
        "docs/develop/documentation.md",
        "docs/develop/testing.md",
        "docs/configure/local-configuration.md",
        "docs/operations/getting-started.md"
      ]
    },
    {
      "name": "project-commands",
      "match": [
        ".opencode/commands/*.md"
      ],
      "docs": [
        "docs/develop/documentation.md"
      ]
    },
    {
      "name": "bounded-docker-build-workflow",
      "match": [
        "compose.yaml",
        "scripts/arm64-smoke.sh",
        "scripts/bounded_docker_build.py",
        "scripts/local-compose.sh",
        "scripts/publish-production-image.sh",
        "scripts/rehearse_schema13.py",
        "scripts/r120-buildkitd.toml",
        "scripts/setup_bounded_buildkit.py",
        "tests/test_bounded_build_entrypoints.py",
        "tests/test_bounded_docker_build.py",
        "tests/test_production_deploy_helper.py",
        "tests/test_schema13_rehearsal.py",
        "tests/test_setup_builder_inventory.py",
        "tests/test_setup_builder_space_guard.py"
      ],
      "docs": [
        "docs/develop/documentation.md",
        "docs/develop/testing.md",
        "docs/operations/getting-started.md"
      ]
    }
  ],
  "additional": [
    {
      "name": "workflow-policy",
      "match": [
        "documentation-map.json",
        "scripts/check-doc-coverage.py",
        "scripts/check-doc-coverage-self-test.py",
        "scripts/setup-git-hooks.sh",
        "model-routing.json",
        "scripts/sync_model_routing.py",
        "scripts/pin_pr_rehearsal_review.py",
        "tools/deploy_mcp/pr_rehearsal.py",
        ".githooks/**",
        "scripts/local-gate.sh",
        "opencode.json",
        ".opencode/.gitignore",
        ".opencode/agents/*.md",
        ".opencode/skills/**",
        ".opencode/skill-history/**",
        ".opencode/plugins/**",
        ".opencode/package.json",
        ".opencode/package-lock.json",
        ".opencode/commands/*.md",
        ".codex/**",
        ".agents/skills/**",
        "compose.yaml",
        "scripts/arm64-smoke.sh",
        "scripts/bounded_docker_build.py",
        "scripts/local-compose.sh",
        "scripts/publish-production-image.sh",
        "scripts/rehearse_schema13.py",
        "scripts/r120-buildkitd.toml",
        "scripts/setup_bounded_buildkit.py",
        "tests/test_bounded_build_entrypoints.py",
        "tests/test_bounded_docker_build.py",
        "tests/test_production_deploy_helper.py",
        "tests/test_schema13_rehearsal.py",
        "tests/test_setup_builder_inventory.py",
        "tests/test_setup_builder_space_guard.py"
      ],
      "docs": [
        "AGENTS.md"
      ]
    }
  ]
}
