# Version control and local tooling are never image inputs.
.git/
.gitignore
.agents/
.codex/
.opencode/
.vscode/
.tools/

# Infrastructure source, provider caches, and Terraform state never enter image builds.
infra/
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
tfplan
*.tfplan
*.plan
**/*.tfstate
**/*.tfstate.*
**/*.tfvars
**/*.tfvars.json
**/tfplan
**/*.tfplan
**/*.plan

# Install dependencies inside the builder instead of copying host environments.
.dev-venv/
.venv/
venv/
burry_env/
**/__pycache__/
*.py[cod]
frontend/node_modules/
frontend/.next/
frontend/out/
src/stock_probs/static/next/

# Keep SQLite databases, their sidecars, and managed backups out of image layers.
data/
backups/
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.spbackup
**/data/
**/backups/
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.spbackup
**/*.spbackup-*

# Exports, tests, documentation, and generated evidence are not runtime package inputs.
SESSION-EXPORT.md
export/
exports/
tests/
test-results/
playwright-report/
htmlcov/
.coverage
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/
*.egg-info/
docs/
# The pinned OpenCode source patch/build harness is the only copied tools subtree.
tools/
!tools/
tools/*
!tools/opencode-v2-security-patch/
tools/opencode-v2-security-patch/*
!tools/opencode-v2-security-patch/manifest.json
!tools/opencode-v2-security-patch/apply_native_patch.py
!tools/opencode-v2-security-patch/apply_oauth_patch.ts
!tools/opencode-v2-security-patch/build_native.py
!tools/opencode-v2-security-patch/google_mcp_patch.py
!tools/opencode-v2-security-patch/oauth-handoff.ts
!tools/opencode-v2-security-patch/oauth-handoff.test.ts
!tools/opencode-v2-security-patch/oauth-broker.ts
!tools/opencode-v2-security-patch/oauth-broker.test.ts
!tools/opencode-v2-security-patch/oauth-callback.ts
!tools/opencode-v2-security-patch/oauth-callback.test.ts
!tools/opencode-v2-security-patch/webfetch-guard.ts
!tools/opencode-v2-security-patch/webfetch-guard.test.ts
!tools/opencode-v2-security-patch/webfetch-native.integration.test.ts
scripts/
*.md

# Credential-like files stay outside the build context even when locally untracked.
.env
.env.*
*.key
*.pem
*.p12
**/.env
**/.env.*
**/*.key
**/*.pem
**/*.p12
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
**/id_rsa*
**/id_dsa*
**/id_ecdsa*
**/id_ed25519*
.aws/
.ssh/
secrets/
credentials/
credentials.json
auth.json
.npmrc
.pypirc
**/.aws/
**/.ssh/
**/secrets/
**/credentials/
**/credentials.json
**/auth.json
**/.npmrc
**/.pypirc

Dockerfile*
compose*.yaml
compose*.yml
.dockerignore
Makefile
opencode.json
