# Version control and local tooling are never image inputs.
.git/
.gitignore
.opencode/
.vscode/
.tools/

# Install dependencies inside the builder instead of copying host environments.
.dev-venv/
.venv/
venv/
burry_env/
**/__pycache__/
*.py[cod]
frontend/node_modules/
frontend/.next/
frontend/out/
src/stock_probs/static/next/

# Keep SQLite databases, their sidecars, and managed backups out of image layers.
data/
backups/
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.spbackup

# Exports, tests, documentation, and generated evidence are not runtime package inputs.
SESSION-EXPORT.md
export/
exports/
tests/
test-results/
playwright-report/
htmlcov/
.coverage
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/
*.egg-info/
docs/
tools/
scripts/
*.md

# Credential-like files stay outside the build context even when locally untracked.
.env
.env.*
*.key
*.pem
*.p12
.aws/
.ssh/
secrets/
credentials/
credentials.json
auth.json
.npmrc
.pypirc

Dockerfile*
compose*.yaml
compose*.yml
.dockerignore
Makefile
opencode.json
