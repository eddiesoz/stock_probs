{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "./scripts/playwright-mcp.sh",
        "--headless",
        "--isolated",
        "--browser",
        "chromium",
        "--allowed-hosts",
        "127.0.0.1,localhost,[::1]",
        "--allowed-origins",
        "http://127.0.0.1:*;http://localhost:*;http://[::1]:8000;http://[::1]:8765",
        "--block-service-workers",
        "--image-responses",
        "omit",
        "--output-dir",
        ".playwright-mcp",
        "--output-max-size",
        "10485760",
        "--timeout-action",
        "10000",
        "--timeout-navigation",
        "30000"
      ],
      "enabled": true,
      "timeout": 30000
    }
  },
  "tool_output": {
    "max_lines": 500,
    "max_bytes": 32768
  }
}
